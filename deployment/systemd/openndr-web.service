[Unit]
Description=OpenNDR Web Frontend Application
Documentation=https://github.com/sheriffhomard/OpenNDROR
After=network.target openndr-backend.service

[Service]
Type=simple
User=openndr
Group=openndr
WorkingDirectory=/opt/openndr
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/npx serve -s dist -l 3000
Restart=always
RestartSec=5s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
