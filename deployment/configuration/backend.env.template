# ==============================================================================
# OpenNDR V0.2 — Variables d'Environnement Backend (Debian 13)
# Emplacement de destination : /etc/openndr/backend.env
# ==============================================================================

OPENNDR_ENV=production
OPENNDR_LOG_LEVEL=INFO
OPENNDR_RELEASE_DATE=2026-11-19

# API REST FastAPI
API_HOST=127.0.0.1
API_PORT=8000
# Générer obligatoirement avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48__
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg2://openndr:__CHANGE_ME_DB_PASSWORD__@127.0.0.1:5432/openndr_db

# Interfaces Réseau
ADMIN_INTERFACE=eth0
CAPTURE_INTERFACE=eth1

# Moteur Réseau Rust (IPC)
ENGINE_SOCKET_PATH=/run/openndr/engine.sock
ENGINE_LOG_LEVEL=info

# Stockage et Rétention PCAP
PCAP_STORAGE_PATH=/var/lib/openndr/captures
MAX_PCAP_STORAGE_GB=500
PCAP_RETENTION_DAYS=30
LOG_RETENTION_DAYS=90

